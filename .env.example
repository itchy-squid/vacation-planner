# Copy to .env (repo root) for local docker-compose use, or set these as
# real environment variables / Container App secrets in Azure.

# ---- Backend ----
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://planner:planner@localhost:5432/vacation_planner
# Azure Database for PostgreSQL Flexible Server (production): no password,
# anywhere — the database only accepts Microsoft Entra ID (Azure AD) auth
# (see infra/README.md "Managed identity database auth" and
# infra/modules/postgres.bicep's authConfig.passwordAuth: 'Disabled').
# The Container App sets these three itself (see
# infra/modules/container-app-backend.bicep); they're shown here only so a
# maintainer running migrations by hand knows what to set locally:
# DATABASE_URL=postgresql+psycopg://app-backend@<server>.postgres.database.azure.com:5432/vacation_planner?sslmode=require
# USE_AZURE_AD_AUTH=true
# AZURE_CLIENT_ID=<only needed for the Container App's managed identity — a maintainer running `az login` locally omits this>

ENVIRONMENT=development
# CORS is not configured here -- the Vite dev server proxies /api and
# /healthz to this backend (see frontend/vite.config.js), so the browser
# never makes a cross-origin request locally. Production CORS is set
# once, at the Container App ingress (infra/modules/container-app-backend.bicep).

# Azure Container Apps built-in auth (Easy Auth) forwards signed-in Entra ID
# users via the X-MS-CLIENT-PRINCIPAL* headers listed below; the backend
# trusts them only when running behind Easy Auth. Locally (no Easy Auth in
# front of you) set DEV_USER_EMAIL so requests are attributed to a fake user
# instead of being rejected.
DEV_USER_EMAIL=mei@example.com

# ---- Frontend ----
# Base URL the frontend calls for the real FastAPI backend — see
# frontend/src/lib/api.js. Defaults to the local uvicorn dev server above.
VITE_API_BASE_URL=http://localhost:8000
# Set once a Google Maps key + Map ID exist (see README "Next steps" —
# Google Maps). Until then, the map screen uses a placeholder basemap.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
