# Copy to .env (repo root) for local docker-compose use, or set these as
# real environment variables / Container App secrets in Azure.

# ---- Backend ----
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://planner:planner@localhost:5432/vacation_planner
# Azure Database for PostgreSQL Flexible Server (production, set via Bicep/Container App secret):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/vacation_planner?sslmode=require

ENVIRONMENT=development
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Azure Container Apps built-in auth (Easy Auth) forwards signed-in Entra ID
# users via the X-MS-CLIENT-PRINCIPAL* headers listed below; the backend
# trusts them only when running behind Easy Auth. Locally (no Easy Auth in
# front of you) set DEV_USER_EMAIL so requests are attributed to a fake user
# instead of being rejected.
DEV_USER_EMAIL=mei@example.com

# ---- Frontend ----
# Base URL the frontend calls for the real FastAPI backend — see
# frontend/src/lib/api.js. Defaults to the local uvicorn dev server above.
VITE_API_BASE_URL=http://localhost:8000
# Set once a Google Maps key + Map ID exist (see README "Next steps" —
# Google Maps). Until then, the map screen uses a placeholder basemap.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
